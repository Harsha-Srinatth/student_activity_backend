# Copy to .env — never commit real .env

# Render sets PORT automatically; for local dev set explicitly (e.g. 3000)
PORT=3000
NODE_ENV=production

MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/dbname
MY_SECRET_KEY=

# Your Vercel deployment URL(s), comma-separated if needed
FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional: extra allowed origins (e.g. custom domain not under *.vercel.app)
# CORS_ORIGINS=https://www.yourdomain.com

# Links in emails / push notifications — public frontend base URL
FRONTEND_URL=https://your-app.vercel.app

LOG_LEVEL=info
MONGO_POOL_SIZE=50

EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

GEMINI_API_KEY=

# Firebase (production): prefer FIREBASE_SERVICE_ACCOUNT JSON or split env vars
# FIREBASE_SERVICE_ACCOUNT=
